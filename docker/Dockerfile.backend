# ─────────────────────────────────────────────────────────────
# Stage 1: Builder — compile Rust workspace
# ─────────────────────────────────────────────────────────────
FROM rust:1-slim AS builder

# Pasang dependency sistem (termasuk protobuf-compiler untuk tonic gRPC dan curl untuk utoipa-swagger-ui)
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev protobuf-compiler curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifest dan proto
COPY Cargo.toml Cargo.lock ./
COPY app/Cargo.toml           app/Cargo.toml
COPY modules/auth/Cargo.toml  modules/auth/Cargo.toml
COPY modules/users/Cargo.toml modules/users/Cargo.toml
COPY proto/                   proto/

# Copy source code lengkap
COPY app/     app/
COPY modules/ modules/

# Compile seluruh binary release (app dan users_service)
RUN cargo build --release --bins

# ─────────────────────────────────────────────────────────────
# Stage 2: Runtime — image minimal
# ─────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Jalankan sebagai non-root
RUN useradd --uid 1001 --create-home appuser
USER appuser

WORKDIR /app

COPY --from=builder /app/target/release/app ./app
COPY --from=builder /app/target/release/users_service ./users_service

ENV RUST_LOG=info
EXPOSE 8000 8001

CMD ["./app"]
