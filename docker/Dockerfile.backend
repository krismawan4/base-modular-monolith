# ─────────────────────────────────────────────────────────────
# Stage 1: Builder — compile Rust workspace
# ─────────────────────────────────────────────────────────────
FROM rust:1.81-slim AS builder

# Pasang dependency sistem minimal
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifest dulu untuk cache dependency layer
COPY Cargo.toml Cargo.lock ./
COPY app/Cargo.toml          app/Cargo.toml
COPY modules/auth/Cargo.toml modules/auth/Cargo.toml

# Buat stub src agar cargo fetch bisa berjalan tanpa source asli
RUN mkdir -p app/src modules/auth/src/internal \
    && echo 'fn main() {}' > app/src/main.rs \
    && echo ''              > modules/auth/src/lib.rs \
    && echo ''              > modules/auth/src/internal/mod.rs \
    && echo ''              > modules/auth/src/internal/repository.rs \
    && echo ''              > modules/auth/src/internal/service.rs

RUN cargo build --release -p app 2>/dev/null || true

# Copy source asli dan compile ulang (hanya source yang berubah)
COPY app/     app/
COPY modules/ modules/
COPY proto/   proto/

RUN touch app/src/main.rs modules/auth/src/lib.rs \
    && cargo build --release -p app

# ─────────────────────────────────────────────────────────────
# Stage 2: Runtime — image minimal
# ─────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Jalankan sebagai non-root
RUN useradd --uid 1001 --create-home appuser
USER appuser

WORKDIR /app

COPY --from=builder /app/target/release/app ./app

ENV RUST_LOG=info
EXPOSE 8000

CMD ["./app"]

