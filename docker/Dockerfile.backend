# ─────────────────────────────────────────────────────────────
# Stage 1: Builder — compile Rust workspace
# ─────────────────────────────────────────────────────────────
FROM rust:1-slim AS builder

# Pasang dependency sistem (termasuk protobuf-compiler untuk tonic gRPC dan curl untuk utoipa-swagger-ui)
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev protobuf-compiler curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Konfigurasi toleransi jaringan Cargo
ENV CARGO_NET_RETRY=10
ENV CARGO_HTTP_TIMEOUT=120
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

# Copy manifest dan proto
COPY Cargo.toml Cargo.lock ./
COPY app/Cargo.toml           app/Cargo.toml
COPY modules/auth/Cargo.toml  modules/auth/Cargo.toml
COPY modules/users/Cargo.toml modules/users/Cargo.toml
COPY proto/                   proto/

# Copy source code lengkap
COPY app/     app/
COPY modules/ modules/

# Compile seluruh binary release dengan cache mount BuildKit
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --release --bins && \
    cp /app/target/release/app /app/app_bin && \
    cp /app/target/release/users_service /app/users_service_bin

# ─────────────────────────────────────────────────────────────
# Stage 2: Runtime — image minimal
# ─────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Jalankan sebagai non-root
RUN useradd --uid 1001 --create-home appuser
USER appuser

WORKDIR /app

COPY --from=builder /app/app_bin ./app
COPY --from=builder /app/users_service_bin ./users_service

ENV RUST_LOG=info
EXPOSE 8000 8001

CMD ["./app"]
