# PostgreSQL Database URL
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/modular_monolith

# Server Bind Address & Port
HOST=127.0.0.1
PORT=8000
RUST_LOG=info
LOG_FORMAT=text # Opsi: "text" (human readable) atau "json" (centralized logging Grafana/Loki)

# JWT Secret
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long!

# Redis Cache / Token Blacklist URL
REDIS_URL=redis://127.0.0.1:6379

# Users Microservice (gRPC) Configuration
# Aktifkan (hilangkan tanda #) jika ingin Aggregator (app) terhubung ke Microservice Users di port 8001:
# USERS_GRPC_URL=http://127.0.0.1:8001
USERS_GRPC_PORT=8001


